# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=replace-with-a-secure-secret-key-in-production

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_eval_db

# LLM Providers (API Keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Execution & Worker Settings
WORKER_CONCURRENCY=4
DEFAULT_RUN_TIMEOUT_SECONDS=120
DEFAULT_BUDGET_CAP_USD=1.00

# Telemetry & Observability
TELEMETRY_ENABLED=true
PII_REDACTION_ENABLED=true
